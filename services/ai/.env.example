# Copy to .env.local for local development. Never commit .env.local.
# Deployed values live in Vercel (project lynx-ai).

# Same value as AI_SERVICE_TOKEN in apps/api/.env.local. Any long random string locally.
AI_SERVICE_TOKEN=

# Model provider keys: only the providers used in config/models.yaml are needed.
# Policy AI-02: use synthetic or test data only until a paid key is approved.
GOOGLE_API_KEY=
