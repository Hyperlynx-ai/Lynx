# OS / editor
.DS_Store
.idea/

# Dependencies and build output
node_modules/
.venv/
venv/
__pycache__/
*.pyc
dist/
build/
.next/
.turbo/
coverage/
*.log

# Environment and secrets (never commit real secrets)
.env
.env.*
!.env.example

# Third-party repos cloned for reference: contents are never committed
references/*
!references/.gitkeep
!references/README.md

# Local agent settings (personal, never shared)
.claude/settings.local.json
.claude/*.local.*

# Tooling caches and local state
.vercel/
.env*.local
*.tsbuildinfo
.pnpm-store/
.pytest_cache/
.ruff_cache/
.mypy_cache/
playwright-report/
test-results/
supabase/.temp/
supabase/.branches/

# Credential files downloaded from providers (never commit)
client_secret*.json
*credentials*.json
