# Copy to .env.local for local development. Never commit .env.local.
# Deployed values live in Vercel (project lynx-api).

API_PORT=4000
LOG_LEVEL=info

# services/ai
AI_SERVICE_URL=http://127.0.0.1:8000
# Same value as AI_SERVICE_TOKEN in services/ai/.env.local. Any long random string locally.
AI_SERVICE_TOKEN=

# Supabase (local stack: `pnpm db:start`, then `pnpm supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_...). Never use it in apps/web.
SUPABASE_SECRET_KEY=
