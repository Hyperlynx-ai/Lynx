{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/related-projects": "^1.1.1",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "openapi-types": "^12.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lynx/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
