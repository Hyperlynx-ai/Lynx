# Copy to .env.local for local development. Never commit .env.local.
# Deployed values live in Vercel (project lynx-web).

# Where /api/* requests are forwarded (apps/api).
API_URL=http://127.0.0.1:4000

# Supabase (public values; local stack: `pnpm db:start`, then `pnpm supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
