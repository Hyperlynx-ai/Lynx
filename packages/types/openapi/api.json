{
  "openapi": "3.0.3",
  "info": {
    "title": "Hyperlynx API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check that also reports whether services/ai is reachable",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "api"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    },
                    "ai": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "unreachable",
                        "not-configured"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "environment",
                    "ai"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
