{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "scripts/mcp-run.mjs",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "node",
        "scripts/mcp-run.mjs",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "git push --no-verify*": "deny",
      "git commit --no-verify*": "deny",
      "git commit -n*": "deny",
      "supabase db reset --linked*": "deny",
      "pnpm supabase db reset --linked*": "deny",
      "npx supabase db reset --linked*": "deny"
    }
  }
}
