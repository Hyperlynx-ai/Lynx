{
  "name": "lynx",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "pnpm --filter api openapi:export && pnpm --filter @lynx/types generate",
    "agents:sync": "node scripts/agents-sync.mjs",
    "setup:check": "node scripts/doctor.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@lynx/config": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^14.0.1",
    "turbo": "^2.11.13",
    "typescript": "^5"
  }
}
