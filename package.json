{
  "name": "lynx",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "e2e": "pnpm --filter web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "pnpm --filter api openapi:export && pnpm --filter @lynx/types generate",
    "db:start": "supabase start -x vector,logflare,edge-runtime,imgproxy",
    "db:env": "node scripts/local-env.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:pull": "pnpm --filter @lynx/db pull",
    "admin:set-role": "node scripts/set-role.mjs",
    "agents:sync": "node scripts/agents-sync.mjs",
    "setup:check": "node scripts/doctor.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@lynx/config": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^14.0.1",
    "supabase": "^3.2.0",
    "turbo": "^2.11.13",
    "typescript": "^7"
  }
}
